---
layout: base.njk
---
<article class="document about-page shell">
  <a class="back-link" href="{{ '/' | url }}">← Back to RelayByte</a>
  <div class="about-grid">
    <header class="about-heading">
      <p class="eyebrow">{{ eyebrow }}</p>
      <h1>{{ heading }}</h1>
      <p class="document-intro">{{ intro }}</p>
    </header>
    <figure class="maker-portrait">
      <img src="{{ '/assets/people/kyle-reddoch.webp' | url }}" width="1000" height="1000" alt="Kyle Reddoch" fetchpriority="high" decoding="async">
      <figcaption><strong>Kyle Reddoch</strong><span>Independent developer · Texas</span></figcaption>
    </figure>
    <div class="prose about-copy">{{ content | safe }}</div>
  </div>
</article>
