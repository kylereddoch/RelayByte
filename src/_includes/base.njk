<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#151718">
  <title>{% if title %}{{ title }} — {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta property="og:title" content="{% if title %}{{ title }} — {% endif %}{{ site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="website">
  {% if site.publicUrl and page.url != '/404.html' %}
  <link rel="canonical" href="{{ page.url | absoluteUrl(site.publicUrl) }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl(site.publicUrl) }}">
  <meta property="og:image" content="{{ '/assets/brand/social-card.png' | absoluteUrl(site.publicUrl) }}">
  <meta property="og:image:alt" content="RelayByte — Independent apps by Kyle Reddoch">
  <meta name="twitter:card" content="summary_large_image">
  {% else %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="icon" href="{{ '/assets/brand/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="icon" href="{{ '/assets/brand/icon-32.png' | url }}" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="{{ '/assets/brand/apple-touch-icon.png' | url }}" sizes="180x180">
  <link rel="preload" href="{{ '/assets/fonts/manrope-latin-variable.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <script src="{{ '/assets/theme-init.js' | url }}"></script>
  <link rel="stylesheet" href="{{ '/assets/site.css' | url }}">
  <script src="{{ '/assets/site.js' | url }}" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header shell">
    <a class="wordmark" href="{{ '/' | url }}" aria-label="RelayByte home"><img class="brand-symbol" src="{{ '/assets/brand/relaybyte-symbol-orange.svg' | url }}" alt="" width="48" height="48"><span>RelayByte</span></a>
    <nav aria-label="Main navigation">
      <a href="{{ '/' | url }}#apps">The apps</a>
      <a href="{{ '/about/' | url }}"{% if page.url == '/about/' %} aria-current="page"{% endif %}>The maker</a>
      <a href="{{ '/support/' | url }}"{% if page.url == '/support/' %} aria-current="page"{% endif %}>Get in touch <span aria-hidden="true">↗</span></a>
    </nav>
  </header>
  <main id="main" tabindex="-1">{{ content | safe }}</main>
  <footer class="site-footer shell">
    <div class="footer-main"><a class="wordmark" href="{{ '/' | url }}" aria-label="RelayByte home"><img class="brand-symbol" src="{{ '/assets/brand/relaybyte-symbol-orange.svg' | url }}" alt="" width="48" height="48"><span>RelayByte</span></a><p>A small software studio.<br>A real person behind it.</p><a class="text-link" href="mailto:{{ site.email }}">Say hello <span aria-hidden="true">↗</span></a></div>
    <div class="footer-meta"><p>© 2026 Kyle Reddoch <span class="footer-separator">/</span> Made in Texas.</p><div class="footer-controls"><a href="{{ '/privacy/' | url }}"{% if page.url == '/privacy/' %} aria-current="page"{% endif %}>Privacy</a><a href="{{ '/terms/' | url }}"{% if page.url == '/terms/' %} aria-current="page"{% endif %}>Purchase terms</a><a href="{{ '/refunds/' | url }}"{% if page.url == '/refunds/' %} aria-current="page"{% endif %}>Refunds</a><label class="theme-control" hidden>Appearance <select id="theme-select" aria-label="Color theme"><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select></label></div></div>
  </footer>
</body>
</html>
